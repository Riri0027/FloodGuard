{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "alerts": {
      ".read": "auth != null",
      ".write": false
    },
    "telemetry": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "publicStatus": {
      "$deviceId": {
        ".read": true,
        ".write": false
      }
    }
  }
}
