# Server-only values. Do not put these in NEXT_PUBLIC_ variables or device firmware repositories.
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@YOUR_PROJECT.iam.gserviceaccount.com","client_id":"..."}
DEVICE_INGEST_KEY=generate-a-long-random-secret
CRON_SECRET=generate-a-second-long-random-secret

# Server-controlled alert policy. Validate these values during a supervised drill
# before changing production configuration.
DEVICE_ID=FG-001
WARNING_CM=75
EVACUATE_CM=150
MAX_LEVEL_CM=200
ALERT_HYSTERESIS_CM=5
ALERT_CONFIRMATION_READINGS=3
SIREN_DURATION_SECONDS=120
DEVICE_OFFLINE_AFTER_SECONDS=300
DEVICE_REQUESTS_PER_MINUTE=30

# Semaphore SMS configuration. Use Philippine recipient numbers such as 0917... or 63917... .
SEMAPHORE_API_KEY=your-semaphore-api-key
SEMAPHORE_SENDER_NAME=FLOODGUARD
ALERT_RECIPIENTS=0917xxxxxxx,0918xxxxxxx
